{
  "permissions": {
    "ask": ["Bash(git push -f *)", "Bash(git push --force-with-lease *)"],
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Bash(ls :*)",
      "Bash(tree :*)",
      "Bash(pwd)",
      "Bash(whoami)",
      "Bash(git :*)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(pnpm :*)",
      "Bash(pytest :*)",
      "Bash(docker :*)",
      "Bash(echo :*)",
      "Bash(mkdir :*)",
      "Bash(mv :*)",
      "Bash(cd :*)",
      "Bash(cp :*)",
      "Bash(cat :*)",
      "Bash(awk :*)",
      "Bash(sed :*)",
      "Bash(head :*)",
      "Bash(find :*)",
      "Bash(rg :*)"
    ]
  },
  "model": "opus",
  "env": { "ENABLE_LSP_TOOL": "1" },
  "alwaysThinkingEnabled": true,
  "useAutoModeDuringPlan": true
}
